# Application Configuration
APP_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth_test

# Model Provider Configuration (anthropic | ollama)
LLM_PROVIDER=anthropic
DEFAULT_LLM_PROVIDER=anthropic

# Cloud LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# RAG & Agent Settings
# NOTE: 0.35 is a development placeholder value. Must be recalibrated after real Lenny transcript corpus ingestion.
RAG_RELEVANCE_DISTANCE_THRESHOLD=0.35
# NOTE: 10 messages (approx 5 user/assistant turns) MVP history window.
CONVERSATION_HISTORY_LIMIT=10
# NOTE: 60 seconds model timeout MVP default.
MODEL_TIMEOUT_SECONDS=60

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

