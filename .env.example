# Application Configuration
APP_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth_test

# Model Provider Configuration (claude | ollama)
DEFAULT_LLM_PROVIDER=claude

# Cloud LLM Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
EMBEDDING_MODEL=nomic-embed-text

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
