# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development | test | production)
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL with pgvector)
# For local host development:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth_test
# For Docker Compose internal networking, DATABASE_URL is set automatically to:
# postgresql://postgres:postgrespassword@postgres:5432/lenny_growth

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=lenny_growth

# Model Provider Configuration (anthropic | ollama)
# Options: "anthropic" (Claude) or "ollama" (local)
llm_provider=ollama

# Cloud LLM Configuration (Anthropic Claude)
# Required if llm_provider=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
anthropic_model=claude-3-5-sonnet-20241022

# Local LLM Configuration (Ollama)
# For local host development: http://localhost:11434
# For Docker Compose container: http://host.docker.internal:11434
ollama_base_url=http://localhost:11434
ollama_model=llama3.2:latest
ollama_embedding_model=nomic-embed-text
embedding_model=nomic-embed-text
embedding_dimension=768

# RAG & Agent Settings
# RAG distance threshold: lower = stricter similarity. Default calibrated on Lenny transcripts:
RAG_RELEVANCE_DISTANCE_THRESHOLD=0.35
# Maximum conversational context history window (turns):
CONVERSATION_HISTORY_LIMIT=10
# LLM generation timeout in seconds:
MODEL_TIMEOUT_SECONDS=60

# CORS Configuration
# Must be formatted as a JSON array string of allowed origin URLs
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend Build-Time Variable (Baked into JS bundle during npm run build / docker build)
VITE_API_BASE_URL=/api
