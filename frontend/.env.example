# Frontend Environment Variables
# IMPORTANT: In Vite, variables prefixed with VITE_ are embedded into the client
# JavaScript bundle at BUILD TIME (during `npm run build` or Docker build).
# They cannot be dynamically overridden at container runtime without rebuilding.

# Base URL for API requests. In production/Docker with Nginx, default is /api (proxied to backend).
# In local development with Vite dev server, default is /api (proxied via vite.config.ts) or http://localhost:8000.
VITE_API_BASE_URL=/api
